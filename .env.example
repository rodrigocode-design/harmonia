# Autenticação própria (login com e-mail/senha). Em produção, defina com:
#   wrangler secret put SESSION_SECRET
# (gere um valor aleatório forte, ex.: `openssl rand -base64 32`). Em dev local,
# o valor já vem configurado em vite.config.ts.
SESSION_SECRET=

HARMONIA_PUBLIC_URL=http://127.0.0.1:8787

# Integrações opcionais ainda não ativadas. Preencha somente em um cofre de segredos.
ANTIMALWARE_PROVIDER=disabled
ANTIMALWARE_WEBHOOK_SECRET=
TRANSACTIONAL_EMAIL_PROVIDER=disabled
TRANSACTIONAL_EMAIL_API_KEY=
ERROR_MONITORING_DSN=
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_TOKEN=
